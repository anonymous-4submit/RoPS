# Copy to .env and set the path to your restored dataset root (the directory that
# contains data/<origin>/<sample_id>.<ext>). See data/DATASET.md for how to
# download and restore it.
#
# The Tier 1 services (rq1, rq2, rq3) and verify-dataset need this. The Tier 0
# table services (rq*-table) and the Tier 0.5 rebuild services (rq*-rebuild) do not.
ROPS_DATASET=/absolute/path/to/rops_dataset
